# Copy to .env and fill in. .env is gitignored.
#
# A classic personal access token with NO scopes ticked is enough for a public repository, and is
# what you want: it raises the rate limit from 60 to 5000 requests an hour and grants nothing else.
GITHUB_TOKEN=

FLAKE_REPO=containers/podman
FLAKE_WORKFLOW=ci.yml
FLAKE_RUNS=40
FLAKE_INTERVAL=3600
FLAKE_BACKEND=heuristic
